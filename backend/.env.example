# ===== 智谱 / ModelScope（照片识星用） =====
ZHIPU_API_KEY=ms-your-key-here
ZHIPU_API_URL=https://api-inference.modelscope.cn/v1/chat/completions
VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
VERIFY_MAX_MAG=6.5
DEBUG_VISION=0

# ===== DeepSeek（导览意图识别用） =====
TOUR_LLM_API_KEY=sk-your-deepseek-key-here
TOUR_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
TOUR_LLM_MODEL=deepseek-flash
TOUR_LLM_ENABLED=1
TOUR_LLM_TIMEOUT=15

# ===== 其他 =====
ASTROMETRY_API_KEY=
USE_MODEL_SEASON=0
ANTI_COMMON_BIAS=1